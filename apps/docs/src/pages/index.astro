---
import Base from "@/src/layouts/Base.astro"
import LandingRoute from "@/components/pages/landing-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base
  title="PaneUI — React components for app interfaces"
  absoluteTitle
  description="React components for app interfaces. The source lands in your app."
>
  <LandingRoute client:load site={site} />
</Base>
