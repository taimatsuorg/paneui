---
import Base from "@/src/layouts/Base.astro"
import ThemingPage, { type ThemingData } from "@/components/pages/theming-page"
import { docNav, highlightAll, siteNavGroups } from "@/lib/build"

const CSS_EXAMPLE = `:root {
  --radius: 0.875rem;
  --radius-max: 1rem;             /* no token goes past 16px */
  --background: oklch(98.8% 0 0);
  --foreground: oklch(18% 0.003 286);
  --muted-foreground: oklch(50% 0.006 286);
  --fill-hover: oklch(18% 0.003 286 / 0.05); /* secondary and muted read it */
  --primary: oklch(18% 0.003 286);
  --primary-text: oklch(18% 0.003 286);      /* links */
  --ring: oklch(65% 0.005 286);
  --border: oklch(18% 0.003 286 / 0.1);
  --border-control: oklch(18% 0.003 286 / 0.46);
  --shadow-lg: inset 0 0 0 1px oklch(0% 0 0 / 0.08), 0 1px 0 oklch(0% 0 0 / 0.04), …;
  /* … */
}

.dark {
  --background: oklch(13% 0.002 286);
  --card: oklch(20% 0.003 286);
  --popover: oklch(22% 0.003 286);
  --foreground: oklch(96% 0.002 286);
  --primary-text: oklch(96% 0.002 286);
  --border: oklch(96% 0.002 286 / 0.1);
  /* … */
}

@theme inline {
  --color-background: var(--background);
  --color-primary: var(--primary);
  --color-primary-text: var(--primary-text);
  --radius-xl: min(calc(var(--radius) * 1.25), var(--radius-max));
  --shadow-lg: var(--shadow-lg);
  /* … */
}`

const DARK_SCRIPT = `// Inline in <head>, before paint, so the page never flashes the wrong theme.
const mode = localStorage.getItem("theme") ?? "system"
const dark = mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
document.documentElement.classList.toggle("dark", dark)
document.documentElement.style.colorScheme = dark ? "dark" : "light"`

const ACCENT_RUNTIME = `/* Switch at runtime by setting data-accent on <html>: one block per mode swaps the ten roles */
html[data-accent="violet"] {
  --primary: oklch(55.8% 0.288 302.32);
  --primary-hover: oklch(52.3% 0.2763 302.32);
  --primary-active: oklch(48.8% 0.258 302.32);
  --primary-foreground: oklch(100% 0 0);
  --primary-subtle: oklch(55.8% 0.288 302.32 / 0.1);
  --primary-subtle-hover: oklch(55.8% 0.288 302.32 / 0.16);
  --primary-border: oklch(55.8% 0.288 302.32 / 0.32);
  --primary-text: oklch(55.5% 0.2592 302.32);
  --ring: oklch(55.8% 0.288 302.32);
  --selection: oklch(55.8% 0.288 302.32 / 0.22);
}
html[data-accent="violet"].dark {
  --primary-text: oklch(71.4% 0.1794 305.5);
  --selection: oklch(71.4% 0.1889 305.5 / 0.4);
  /* … */
}`

const NEW_TOKEN = `:root  { --brand-2: oklch(0.6 0.12 200); }
.dark  { --brand-2: oklch(0.68 0.12 200); }

@theme inline {
  --color-brand-2: var(--brand-2);   /* → bg-brand-2, text-brand-2, ring-brand-2/20 … */
}`

const code = await highlightAll(
  { css: CSS_EXAMPLE, darkScript: DARK_SCRIPT, accentRuntime: ACCENT_RUNTIME, newToken: NEW_TOKEN },
  { css: "css", darkScript: "js", accentRuntime: "css", newToken: "css" },
)

const data: ThemingData = {
  nav: docNav("/docs/theming", ["components/pages/theming-page.tsx", "components/docs/theming-system.tsx", "components/docs/theming-accent.tsx"]),
  code,
}
const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base title="Theming">
  <ThemingPage client:load site={site} data={data} />
</Base>
