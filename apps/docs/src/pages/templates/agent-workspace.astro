---
import Base from "@/src/layouts/Base.astro"
import AgentWorkspaceTemplateRoute from "@/components/pages/templates/agent-workspace-route"
import { siteNavGroups } from "@/lib/build"

const site = { pathname: Astro.url.pathname, groups: siteNavGroups() }
---

<Base fullscreen title="Agent Workspace template">
  <AgentWorkspaceTemplateRoute client:load site={site} />
</Base>
