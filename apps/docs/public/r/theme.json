      "shadow-lg": "0 0 0 1px oklch(94.5% 0.008 82 / 0.14), 0 6px 14px -4px oklch(0% 0 0 / 0.42), 0 18px 36px -12px oklch(0% 0 0 / 0.56)",
      "shadow-xl": "0 0 0 1px oklch(94.5% 0.008 82 / 0.12) inset, 0 12px 28px -8px oklch(0% 0 0 / 0.44), 0 32px 64px -16px oklch(0% 0 0 / 0.62)",
      "skeuo-raised": "var(--shadow-default)",
      "skeuo-raised-hover": "0 0 0 1px oklch(94.5% 0.008 82 / 0.16) inset, 0 1px 3px oklch(0% 0 0 / 0.38)",
      "skeuo-pressed": "inset 0 1px 2px oklch(0% 0 0 / 0.5), 0 0 0 1px oklch(94.5% 0.008 82 / 0.1)",
      "skeuo-primary": "0 0 0 0 transparent",
      "skeuo-well": "inset 0 0 0 1px var(--input)",
      "skeuo-surface": "var(--shadow-lg)",
      "skeuo-chip": "var(--shadow-border)",
      "image-outline": "oklch(1 0 0 / 0.1)"
    }
  },
  "css": {
    "@layer base": {
      "::-webkit-scrollbar": {
        "width": "12px",
        "height": "12px"
      },
      "::-webkit-scrollbar-track, ::-webkit-scrollbar-corner": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-thumb": {
        "border": "3px solid transparent",
        "border-radius": "9999px",
        "background-color": "var(--scrollbar)",
        "background-clip": "padding-box",
        "min-height": "40px"
      },
      "::-webkit-scrollbar-thumb:hover": {
        "background-color": "var(--scrollbar-hover)"
      },
      "@supports not selector(::-webkit-scrollbar)": {
        "*": {
          "scrollbar-width": "thin",
          "scrollbar-color": "var(--scrollbar) transparent"
        }
      },
      "body": {
        "letter-spacing": "normal"
      },
      "code, kbd, pre, samp": {
        "font-feature-settings": "normal"
      },
      "*, ::before, ::after": {
        "--frame-r": "0px",
        "--frame-p": "0px",
        "--frame-b": "0px"
      },
      "html": {
        "background-color": "var(--background)"
      },
      "::selection": {
        "background-color": "var(--selection)"
      },
      "[data-speaking]": {
        "border-radius": "var(--radius-sm)",
        "background-color": "var(--accent)",
        "box-shadow": "0 0 0 4px var(--accent), 0 0 0 5px color-mix(in oklab, var(--ring) 20%, transparent)",
        "transition": "background-color 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms cubic-bezier(0.22, 1, 0.36, 1)",
        "scroll-margin-bottom": "calc(var(--bottom-overlay-offset, 0px) + 1rem)"
      }
    },
    "@utility scrollbar-thin": {
      "scrollbar-width": "thin",
      "&::-webkit-scrollbar": {
        "width": "10px",
        "height": "10px"
      }
    },
    "@utility scrollbar-hover": {
      "scrollbar-color": "transparent transparent",
      "&::-webkit-scrollbar-thumb": {
        "background-color": "transparent"
      },
      "&:hover": {
        "scrollbar-color": "var(--scrollbar) transparent"
      },
      "&:hover::-webkit-scrollbar-thumb": {
        "background-color": "var(--scrollbar)"
      }
    },
    "@utility scrollbar-none": {
      "scrollbar-width": "none",
      "&::-webkit-scrollbar": {
        "display": "none"
      }
    },
    "@utility shell-inset": {
      "background-color": "var(--background)",
      "border": "0.5px solid var(--shell-border)",
      "border-radius": "var(--radius-shell)",
      "margin-inline-end": "3px",
      "margin-bottom": "3px"
    },
    "@utility window-drag": {
      "-webkit-app-region": "drag",
      "user-select": "none"
    },
    "@utility window-no-drag": {
      "-webkit-app-region": "no-drag"
    },
    "@utility media-outline": {
      "outline": "1px solid oklch(0 0 0 / 0.1)",
      "outline-offset": "-1px",
      "&:is(.dark *)": {
        "outline-color": "oklch(1 0 0 / 0.1)"
      }
    },
    "@utility icon-bold": {
      "--icon-stroke-scale": "1.2"
    },
    "@utility icon-regular": {
      "--icon-stroke-scale": "1"
    },
    "@utility scroll-fade-y": {
      "mask-image": "linear-gradient(to bottom, transparent, #000 var(--scroll-fade-top, 0px), #000 calc(100% - var(--scroll-fade-bottom, 0px)), transparent)",
      "animation": "var(--scroll-fade-y-animation, none)",
      "animation-timeline": "scroll(self), scroll(self)",
      "animation-range": "0 2px, calc(100% - 2px) 100%"
    },
    "@keyframes scroll-fade-top": {
      "from": {
        "--scroll-fade-top": "0px"
      },
      "to": {
        "--scroll-fade-top": "24px"
      }
    },
    "@keyframes scroll-fade-bottom": {
      "from": {
        "--scroll-fade-bottom": "24px"
      },
      "to": {
        "--scroll-fade-bottom": "0px"
      }
    },
    "@utility pb-bottom-overlay": {
      "padding-bottom": "var(--bottom-overlay-offset, 0px)"
    },
    "@utility scroll-fade-x": {
      "mask-image": "linear-gradient(to right, transparent, #000 var(--scroll-fade-start, 0px), #000 calc(100% - var(--scroll-fade-end, 0px)), transparent)",
      "animation": "var(--scroll-fade-x-animation, none)",
      "animation-timeline": "scroll(self inline), scroll(self inline)",
      "animation-range": "0 2px, calc(100% - 2px) 100%"
    },
    "@keyframes scroll-fade-start": {
      "from": {
        "--scroll-fade-start": "0px"
      },
      "to": {
        "--scroll-fade-start": "24px"
      }
    },
    "@keyframes scroll-fade-end": {
      "from": {
        "--scroll-fade-end": "24px"
      },
      "to": {
        "--scroll-fade-end": "0px"
      }
    },
    "@supports (animation-timeline: scroll())": {
      ":root": {
        "--scroll-fade-y-animation": "scroll-fade-top linear both, scroll-fade-bottom linear both",
        "--scroll-fade-x-animation": "scroll-fade-start linear both, scroll-fade-end linear both"
      }
    },
    "@utility frame-*": {
      "--frame-r": "--value(--radius-*, [length])",
      "border-radius": "--value(--radius-*, [length])",
      "--frame-inner-1": "max(calc(var(--frame-r) - var(--frame-p) - var(--frame-b)), 0px)",
      "--frame-inner-2": "initial"
    },
    "@utility frame-p-*": {
      "--frame-p": "--spacing(--value(integer, number))",
      "padding": "--spacing(--value(integer, number))"
    },
    "@utility frame-inset-*": {
      "--frame-p": "--spacing(--value(integer, number))"
    },
    "@utility frame-border": {
      "--frame-b": "1px"
    },
    "@utility rounded-inner": {
      "border-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))"
    },
    "@utility rounded-t-inner": {
      "border-top-left-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))",
      "border-top-right-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))"
    },
    "@utility rounded-b-inner": {
      "border-bottom-left-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))",
      "border-bottom-right-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))"
    },
    "@utility rounded-s-inner": {
      "border-start-start-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))",
      "border-end-start-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))"
    },
    "@utility rounded-e-inner": {
      "border-start-end-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))",
      "border-end-end-radius": "var(--frame-inner-2, var(--frame-inner-1, var(--radius-lg)))"
    },
    "@utility rounded-inner-*": {
      "border-radius": "var(--frame-inner-2, var(--frame-inner-1, --value(--radius-*)))"
    },
    "@utility rounded-inner-or-*": {
      "border-radius": "max(var(--frame-inner-2, var(--frame-inner-1, 0px)), min(--value(--radius-*), var(--radius-sm)))"
    },
    "@utility frame-inner": {
      "--frame-r": "var(--frame-inner-1, var(--radius-lg))",
      "border-radius": "var(--frame-inner-1, var(--radius-lg))",
      "--frame-inner-2": "max(calc(var(--frame-r) - var(--frame-p) - var(--frame-b)), 0px)"
    }
  },
  "meta": {
    "category": "Foundations",
    "version": "2.6"
  },
  "type": "registry:theme"
}